         self.mal_alpha = mal_alpha
         self.use_uni_set = use_uni_set
 
+    @staticmethod
+    def _labelled_mask(targets, logits):
+        """ojas: [B, 1, C] with 0 on the classes a frame does not label (target['unlabelled'], from the
+        image field `unlabelled_cats`), else None. A person in a frame that never labels people is
+        then neither a positive nor a negative for the person class; every other class learns from
+        the frame as usual. Skipped for class-agnostic heads (C == 1)."""
+        C = logits.shape[-1]
+        if C <= 1:
+            return None
+        m = None
+        for b, t in enumerate(targets):
+            u = t.get('unlabelled')
+            if u is None or u.numel() == 0:
+                continue
+            u = u[(u >= 0) & (u < C)]
+            if m is None:
+                m = torch.ones(logits.shape[0], 1, C, device=logits.device, dtype=logits.dtype)
+            m[b, 0, u] = 0
+        return m
+
     def loss_labels_focal(self, outputs, targets, indices, num_boxes):
         assert 'pred_logits' in outputs
         src_logits = outputs['pred_logits']
