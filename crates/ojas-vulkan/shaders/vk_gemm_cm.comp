// precisions: f16
// Test kernel: C (fp32, M x N) = A (f16, M x K row-major) . B^T (B f16, N x K
// row-major) on cooperative matrices — the matrix-unit ceiling of this
// driver without any conv logic. 128x128 tile per workgroup of 4 subgroups
// (64x64 each = 4x4 fragments), K chunks of 32 through shared memory.
// Requires M, N multiples of 128 and K a multiple of 32.
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#define LDS 40
shared float16_t As[128 * LDS];
shared float16_t Bs[128 * LDS];
layout(buffer_reference, std430, buffer_reference_align = 4) buffer FBuf { float v[]; };
layout(push_constant) uniform P { RoU4Buf a; RoU4Buf b; FBuf c; int m; int n; int k; } p;
#define PUT8(dst, at, q) { \
    f16vec2 h0_ = unpackFloat2x16((q).x), h1_ = unpackFloat2x16((q).y), h2_ = unpackFloat2x16((q).z), h3_ = unpackFloat2x16((q).w); \
    dst[(at)] = h0_.x; dst[(at) + 1] = h0_.y; dst[(at) + 2] = h1_.x; dst[(at) + 3] = h1_.y; \
    dst[(at) + 4] = h2_.x; dst[(at) + 5] = h2_.y; dst[(at) + 6] = h3_.x; dst[(at) + 7] = h3_.y; }
// No arrays of cooperative matrices and no loops over them: the SPIR-V is
// not optimized (glslang without SPIRV-Tools), and drivers may keep arrays of
// matrices indexed in loops in local memory. Everything is spelled out.
#define ACC coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>
#define MA coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA>
#define MB coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB>
#define ROW4(i) c##i##0 = coopMatMulAdd(a##i, b0, c##i##0); c##i##1 = coopMatMulAdd(a##i, b1, c##i##1); \
                c##i##2 = coopMatMulAdd(a##i, b2, c##i##2); c##i##3 = coopMatMulAdd(a##i, b3, c##i##3);
#define STORE(i, j) coopMatStore(c##i##j, p.c.v, (m0 + sy * 64 + i * 16) * p.n + n0 + sx * 64 + j * 16, p.n, gl_CooperativeMatrixLayoutRowMajor);
void main() {
    int tid = int(gl_LocalInvocationID.x), nth = int(gl_WorkGroupSize.x);
    int sg = int(gl_SubgroupID), sy = sg / 2, sx = sg % 2;
    int m0 = int(gl_WorkGroupID.x) * 128, n0 = int(gl_WorkGroupID.y) * 128;
    ACC c00 = ACC(0.0), c01 = ACC(0.0), c02 = ACC(0.0), c03 = ACC(0.0);
    ACC c10 = ACC(0.0), c11 = ACC(0.0), c12 = ACC(0.0), c13 = ACC(0.0);
    ACC c20 = ACC(0.0), c21 = ACC(0.0), c22 = ACC(0.0), c23 = ACC(0.0);
    ACC c30 = ACC(0.0), c31 = ACC(0.0), c32 = ACC(0.0), c33 = ACC(0.0);
    int kv = p.k / 8;
    for (int k0 = 0; k0 < p.k; k0 += 32) {
        for (int idx = tid; idx < 128 * 4; idx += nth) {
            int r = idx / 4, q = idx % 4;
            PUT8(As, r * LDS + q * 8, p.a.v[(m0 + r) * kv + k0 / 8 + q])
            PUT8(Bs, r * LDS + q * 8, p.b.v[(n0 + r) * kv + k0 / 8 + q])
        }
        barrier();
        for (int kk = 0; kk < 32; kk += 16) {
            MA a0, a1, a2, a3;
            MB b0, b1, b2, b3;
            coopMatLoad(a0, As, (sy * 64 + 0) * LDS + kk, LDS, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(a1, As, (sy * 64 + 16) * LDS + kk, LDS, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(a2, As, (sy * 64 + 32) * LDS + kk, LDS, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(a3, As, (sy * 64 + 48) * LDS + kk, LDS, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(b0, Bs, (sx * 64 + 0) * LDS + kk, LDS, gl_CooperativeMatrixLayoutColumnMajor);
            coopMatLoad(b1, Bs, (sx * 64 + 16) * LDS + kk, LDS, gl_CooperativeMatrixLayoutColumnMajor);
            coopMatLoad(b2, Bs, (sx * 64 + 32) * LDS + kk, LDS, gl_CooperativeMatrixLayoutColumnMajor);
            coopMatLoad(b3, Bs, (sx * 64 + 48) * LDS + kk, LDS, gl_CooperativeMatrixLayoutColumnMajor);
            ROW4(0) ROW4(1) ROW4(2) ROW4(3)
        }
        barrier();
    }
    STORE(0, 0) STORE(0, 1) STORE(0, 2) STORE(0, 3)
    STORE(1, 0) STORE(1, 1) STORE(1, 2) STORE(1, 3)
    STORE(2, 0) STORE(2, 1) STORE(2, 2) STORE(2, 3)
    STORE(3, 0) STORE(3, 1) STORE(3, 2) STORE(3, 3)
}
