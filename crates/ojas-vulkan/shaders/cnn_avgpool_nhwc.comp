// precisions: f16
// Average pool on padded NHWC (CUDA cnn_avgpool_nhwc); count_include_pad
// selects the divisor. Float sum.
layout(push_constant) uniform P { Buf x; Buf y; int n; int ch; int h; int w; int ipad; int iwp; int iimg; int oh; int ow;
                                  int opad; int owp; int oimg; int kh; int kw; int sh; int sw; int pt; int pl; int ics; int ocs; int count_include_pad; } p;
void main() {
    int i = GID;
    if (i >= p.n) return;
    int c = i % p.ch, t = i / p.ch, ox = t % p.ow;
    t /= p.ow;
    int oy = t % p.oh, im = t / p.oh;
    int hs = oy * p.sh - p.pt, ws = ox * p.sw - p.pl;
    float sum = 0.0;
    int cnt = 0;
    for (int yy = hs; yy < hs + p.kh; yy++) {
        if (yy < 0 || yy >= p.h) continue;
        for (int xx = ws; xx < ws + p.kw; xx++) {
            if (xx < 0 || xx >= p.w) continue;
            sum += LD(p.x, im * p.iimg + ((yy + p.ipad) * p.iwp + xx + p.ipad) * p.ics + c);
            cnt++;
        }
    }
    int dv = p.count_include_pad != 0 ? p.kh * p.kw : (cnt > 0 ? cnt : 1);
    ST(p.y, im * p.oimg + ((oy + p.opad) * p.owp + ox + p.opad) * p.ocs + c, sum / float(dv));
}
